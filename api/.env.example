# Passly API — local environment.
# Copy this file to `.env` (this example is committed; `.env` is gitignored).
# The app auto-loads `api/.env` on startup. Run the API from the api/ directory
# so the relative paths below resolve.

# ── Apple Wallet pass signing (P1) ───────────────────────────────────
# These two are already known from the Pass Type ID certificate:
APPLE_TEAM_ID=AVN9H8BY3X
APPLE_PASS_TYPE_ID=pass.com.passly

# Signing material — kept out of git (*.p12 / certs/ are gitignored).
# Paths are relative to the api/ directory:
APPLE_CERT_P12=../passly.p12
APPLE_WWDR_CERT=../certs/AppleWWDRCAG4.cer

# The password you set when exporting the .p12 from Keychain. FILL THIS IN.
# (Leave everything above as-is; only this line needs your value.)
APPLE_CERT_PASSWORD=

# ── Email the pass to new members (Resend) ───────────────────────────
# Without RESEND_API_KEY, emails go to a no-op FakeEmailSender (recorded,
# not sent) — that's why no mail arrives out of the box. To send for real:
#   1) get a key at resend.com  2) uncomment the line below  3) restart uvicorn.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
#
# Sender. The sandbox sender below needs no domain, BUT Resend then only
# delivers to YOUR OWN Resend-account email until you verify a domain — so
# enrol with that email to test.
# PASSLY_EMAIL_FROM=onboarding@resend.dev
#
# Base URL put in the emailed pass link (the API's origin). Default localhost
# opens on this machine; set a reachable URL to open the link from a phone.
# PASSLY_PUBLIC_URL=http://localhost:8000

# ── Optional: real LLM for the crew ──────────────────────────────────
# Without a key the crew uses a deterministic MockLLM (fine for the demo).
# ANTHROPIC_API_KEY=sk-ant-...
